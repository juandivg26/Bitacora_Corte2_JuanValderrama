@startuml
title Normalizacion de la informacion - American Bites (1FN a 3FN)
hide circle
skinparam shadowing false

package "0FN - Tabla sin normalizar" {
  entity "PEDIDO" as t0 {
    id_pedido [PK]
    fecha
    id_mesa
    numero_mesa
    capacidad_mesa
    cliente
    platos (multivaluado)
    precios (multivaluado)
  }
}

package "1FN - Se eliminan los grupos repetitivos (datos atomicos)" {
  entity "PEDIDO_1FN" as t1a {
    id_pedido [PK]
    fecha
    id_mesa
    numero_mesa
    capacidad_mesa
    cliente
  }
  entity "ITEM_1FN" as t1b {
    id_pedido [PK/FK]
    id_plato [PK]
    nombre_plato
    precio
    cantidad
  }
}

package "2FN - Se eliminan las dependencias parciales" {
  entity "PEDIDO_2FN" as t2a {
    id_pedido [PK]
    fecha
    id_mesa
    numero_mesa
    capacidad_mesa
    cliente
  }
  entity "ITEM_2FN" as t2b {
    id_pedido [PK/FK]
    id_plato [PK/FK]
    cantidad
  }
  entity "PLATO_2FN" as t2c {
    id_plato [PK]
    nombre_plato
    precio
  }
}

package "3FN - Se eliminan las dependencias transitivas" {
  entity "MESAS" as t3a {
    id [PK]
    numero [UNIQUE]
    capacidad
    estado
    cuenta_abierta
  }
  entity "PLATOS" as t3b {
    id [PK]
    nombre [UNIQUE]
    precio
    categoria
    disponible
  }
  entity "PEDIDOS" as t3c {
    id [PK]
    id_mesa [FK]
    estado
    timestamp
  }
  entity "ITEMS_PEDIDO" as t3d {
    id [PK]
    pedido_id [FK]
    id_plato [ref. logica]
    nombre_plato
    precio_congelado
    cantidad
  }
  entity "CUENTAS" as t3e {
    id [PK]
    id_mesa [FK]
    total
    estado
    fecha_apertura
  }
  entity "RESERVAS" as t3f {
    id [PK]
    id_mesa [FK]
    cliente
    fecha_hora
    comensales
    cancelada
  }
}

t1a ||--o{ t1b
t2a ||--o{ t2b
t2c ||--o{ t2b
t3a ||--o{ t3c
t3a ||--o{ t3e
t3a ||--o{ t3f
t3c ||--|{ t3d
t3b ||..o{ t3d
@enduml
