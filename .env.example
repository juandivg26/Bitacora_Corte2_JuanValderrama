# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Nunca subas el archivo .env al repositorio.

# API
API_PORT=8080

# PostgreSQL
POSTGRES_DB=american_bites
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CLAVE_SEGURA
POSTGRES_PORT=5432

# MongoDB
MONGO_DB=american_bites
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
MONGO_PORT=27017

# JWT: mínimo 32 bytes; idealmente un valor Base64 fuerte y privado.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_JWT_SEGURO_DE_AL_MENOS_32_BYTES
JWT_EXPIRATION_MS=3600000

# HTTPS (perfil ssl, opcional)
SSL_KEYSTORE_PASSWORD=

# OAuth2 con Google (perfil oauth2, opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
