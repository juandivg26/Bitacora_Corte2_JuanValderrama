# Copiar a .env.properties (ignorado por Git) para ejecutar con `mvn spring-boot:run` sin Docker.
DB_PASSWORD=CLAVE_POSTGRES_LOCAL
# Mínimo 32 bytes. Generar uno con: openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_JWT_SEGURO_DE_AL_MENOS_32_BYTES

# Perfil ssl (opcional)
# SSL_KEYSTORE_PASSWORD=
# Perfil oauth2 (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
